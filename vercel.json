{
  "rewrites": [
    { "source": "/estudios",        "destination": "/api/estudios"        },
    { "source": "/evaluaciones",    "destination": "/api/evaluaciones"    },
    { "source": "/cola",            "destination": "/api/cola"            },
    { "source": "/recepcion-postulaciones", "destination": "/api/recepcion-postulaciones" },
    { "source": "/historial",       "destination": "/api/historial"       },
    { "source": "/notificaciones",  "destination": "/api/notificaciones"  },
    { "source": "/experiencia",     "destination": "/api/experiencia"     },
    { "source": "/informes",        "destination": "/api/informes"        },
    { "source": "/emparejamiento",  "destination": "/api/emparejamiento"  },
    { "source": "/conversaciones",  "destination": "/api/conversaciones"  },
    { "source": "/privacidad",      "destination": "/api/privacidad"      }
  ],
  "functions": {
    "api/estudios.js": {
      "maxDuration": 300
    },
    "api/informes.js": {
      "maxDuration": 300
    },
    "api/evaluaciones.js": {
      "maxDuration": 300
    },
    "api/conversaciones.js": {
      "maxDuration": 300
    },
    "api/emparejamiento.js": {
      "maxDuration": 300
    },
    "api/experiencia.js": {
      "maxDuration": 300
    },
    "api/cola.js": {
      "maxDuration": 60
    },
    "api/notificaciones.js": {
      "maxDuration": 60
    },
    "api/recepcion-postulaciones.js": {
      "maxDuration": 30
    },
    "api/historial.js": {
      "maxDuration": 30
    },
    "api/privacidad.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cola",           "schedule": "* * * * *" },
    { "path": "/api/notificaciones", "schedule": "* * * * *" }
  ]
}
