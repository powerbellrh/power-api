{
  "rewrites": [
    { "source": "/estudios",        "destination": "/api/estudios"        },
    { "source": "/postulaciones",   "destination": "/api/postulaciones"   },
    { "source": "/catalogo",        "destination": "/api/catalogo"        },
    { "source": "/cola",            "destination": "/api/cola"            },
    { "source": "/recepcion-postulaciones", "destination": "/api/recepcion-postulaciones" }
  ],
  "functions": {
    "api/estudios.js": {
      "maxDuration": 300
    },
    "api/postulaciones.js": {
      "maxDuration": 300
    },
    "api/catalogo.js": {
      "maxDuration": 30
    },
    "api/cola.js": {
      "maxDuration": 60
    },
    "api/recepcion-postulaciones.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/cola", "schedule": "* * * * *" }
  ]
}
